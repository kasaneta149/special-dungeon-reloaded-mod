  "dogs_speak.text_1": "Hey, ça fait mal !",
  "dogs_speak.text_2": "Aie, mais arrête",
  "dogs_speak.text_3": "S'il te plaît arrête ça",
  "dogs_speak.text_4": "Je t'en supplie ne me tue pas",
  "dogs_speak.text_5": "Arrête de me faire frapper !!!!",
  "dogs_speak.text_6": "Laisse moi tranquille s'il te plaît",
  "dogs_speak.text_7": "je veux pas mourir !!!!!",
  "dogs_speak.text_8": "tu vas vraiment me...",
  "dogs_speak.text_9": "arrête sinon je pleure !!",
  "dogs_speak.text_10": "S'IL VOUS PLAIT QUE QU'UNE PERSONNE FASSE QUELQUE CHOSE ",
  "dogs_speak.text_11": "JE ME FAIT AGRESSÉ QUELQU'UN FAIT QUEQUE CHOSE",
  "dogs_speak.text_12": "mon ventre me fait tellement mal...",
  "dogs_speak.text_13": "pourquoi tu fais ça ?",
  "dogs_speak.text_14": "J'APPELLE LA POLICE!!!",
  "dogs_speak.text_15": "personne m'a jamais appris à me défendre...",
  "dogs_speak.text_16": "maman où es-tu ??",
  "dogs_speak.text_17": "je promets que j'ai rien fait de mal !",
  "dogs_speak.text_18": "j'y comprends rien... qu'est-ce que j'ai fait...",
  "dogs_speak.text_19": "j'ai peur... vraiment peur...",
  "dogs_speak.text_20": "me fais pas... disparaître...",
