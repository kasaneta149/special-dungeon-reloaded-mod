  "writes.text_22_1": "§cTheres no escape.",
  "writes.text_23_1": "§cYou are done.",
  "writes.text_24_1": "§cThere no way for you to escape this place, you are doomed.",
  "painting.special_dungeon_reloaded.bp_1.author": "Kouri",
  "painting.special_dungeon_reloaded.bp_1.title": "...",
  "painting.special_dungeon_reloaded.bp_2.title": "...",
  "painting.special_dungeon_reloaded.bp_2.author": "Kouri",
  "painting.special_dungeon_reloaded.bp_3.title": "...",
  "painting.special_dungeon_reloaded.bp_3.author": "Kouri",
