  "dogs_speak.text_1": "Hey, this hurt !",
  "dogs_speak.text_2": "Ough, stop",
  "dogs_speak.text_3": "Please stop that",
  "dogs_speak.text_4": "I beg you please don't kill me",
  "dogs_speak.text_5": "stop hurting me !!!!",
  "dogs_speak.text_6": "leave me alone please",
  "dogs_speak.text_7": "i don't want to die !!!!!",
  "dogs_speak.text_8": "are you really going to...",
  "dogs_speak.text_9": "stop or i cry !!",
  "dogs_speak.text_10": "PLEASE SOMEONE HELP ME",
  "dogs_speak.text_11": "IM GETTING AGRESSED PLEASE SOMEBODY DO SOMETHING",
  "dogs_speak.text_12": "my tummy hurts so much...",
  "dogs_speak.text_13": "why are you doing this?",
  "dogs_speak.text_14": "IM CALLING POLICE NOW!!!",
  "dogs_speak.text_15": "nobody ever taught me to fight back...",
  "dogs_speak.text_16": "mom where are you ??",
  "dogs_speak.text_17": "i promise i didnt do anything wrong !",
  "dogs_speak.text_18": "i don't understand... what did i do...",
  "dogs_speak.text_19": "im scared... really scared...",
  "dogs_speak.text_20": "dont... dont make me disappear...",
