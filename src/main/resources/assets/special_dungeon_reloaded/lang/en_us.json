  "painting.special_dungeon_reloaded.fface_1.author": "unknown",
  "painting.special_dungeon_reloaded.fface_1.title": "face",
  "painting.special_dungeon_reloaded.fface_2.title": "face",
  "painting.special_dungeon_reloaded.fface_2.author": "unknown",
  "writes.text_25_1": "§cYou will die there, and if you keep resisting, then, we will come for you.",
  "writes.text_26_1": "§cMoving forward will only worsen your situation",
  "writes.text_27_1": "§cYou want to meet our boss? HAHAHAHAHAHAHAHAHAHAHAHA. what a joke.",
  "writes.text_28_1": "§cIf you think a joke like YOU can kill our lord",
  "writes.text_29_1": "§cYou are somewhat, FUCKING DUMB!!!!",
  "writes.text_29_2": "§cJust accept your fate.",
  "writes.text_29_3": "§cWe warned you engouth times.",
  "writes.text_30_1": "§cListen, you can either stays with us here, and wait for us to eat you, or die now, what do you choose ?",
  "writes.text_31_1": "§cAlright, you choosed your side. ",
  "writes.text_32_1": "§cThis is your last chance, at the end of this corridor; there is the elevator that will take you to our lord.",
  "writes.text_32_2": "§cTHINK ABOUT IT WISELY THERE NO GOING BACK.",
  "block.special_dungeon_reloaded.afterfinalblock": "After final block",
  "block.special_dungeon_reloaded.blackbreakonfinal": "black",
  "entity.special_dungeon_reloaded.finalboss": "dog lord",
  "writes.text_33_1": "CONGRATULATION, you have beaten the final boss of the mod !!!",
  "writes.text_33_2": "you have been rewarded some best quality stuff and above all... you received the BEDROCK DESTROYER, a tool capable of breaking bedrock.",
  "writes.text_33_3": "The final boss won't summon again, but your tool will last forever.",
  "writes.text_33_4": "Feel free to continue vising the dungeon of the mod in case you havent saw them all, otherwise, this is the end of this mod and i hope you enjoyed it !",
  "writes.text_33_5": "Goodbye, and thanks you for your visit in our museum !",
